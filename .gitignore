# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 构建产物（dist/ 约 115 MB，由 `pyinstaller PixelPress.spec` 重新生成）
build/
dist/

# 运行期审计与日志输出（内容随每次运行变化，脚本可重新生成）
benchmarks/*.txt
benchmarks/*.log

# ZCode 本地工作区（plan / 缓存，不入库）
.zcode/
.zcodeignore

# 编辑器与系统
.idea/
.vscode/
Thumbs.db
Desktop.ini

# 说明：以下两项刻意 *不* 忽略，以保证克隆后可直接打包：
#   vendor/oxipng.exe      MIT，968 KB，spec 的 datas 需要它
#   app/assets/fonts/*.ttf OFL-1.1，1.0 MB，随包字体（见同目录 LICENSE-*.txt）
